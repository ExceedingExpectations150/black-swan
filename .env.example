# ChaosNet "Black Swan" — copy to .env and fill in real values.
# Both Gemini keys are REQUIRED: GeminiModelRouter raises at startup without them
# (no mock fallback exists, PRD rule 4.1). Get keys at https://aistudio.google.com/apikey
GEMINI_API_KEY_PRIMARY=
GEMINI_API_KEY_BACKUP=

# Optional: defaults to sqlite:///./blackswan.db
# DATABASE_URL=postgresql://user:pass@localhost:5432/blackswan
