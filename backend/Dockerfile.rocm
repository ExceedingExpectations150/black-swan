# Black Swan backend — AMD GPU variant.
# Identical app to the CPU Dockerfile; the ONLY difference is the PyTorch
# wheel: this pulls the ROCm build, which dispatches TimesFM to an AMD
# Instinct / Radeon GPU through the standard torch.cuda API — no code change.
#
# Build:  docker build -f Dockerfile.rocm -t blackswan-backend:rocm ./backend
# Run  :  docker run --device=/dev/kfd --device=/dev/dri --group-add video \
#           --security-opt seccomp=unconfined -p 8010:8000 blackswan-backend:rocm
# (or set dockerfile: Dockerfile.rocm + the device mounts in docker-compose.yml)
#
# Requires an AMD ROCm host (Linux, ROCm 6.x drivers). The startup log prints
# `TimesFM device=cuda backend=ROCm/HIP` when it lands on the GPU.
FROM python:3.12-slim

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*

# The ROCm PyTorch wheel (vs the CPU wheel in the default Dockerfile). Match
# the tag to the host's ROCm version.
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/rocm6.2

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

ENV PYTHONUNBUFFERED=1
ENV HF_HOME=/app/.hf-cache

EXPOSE 8000
CMD ["sh", "-c", "uvicorn main:app --host 0.0.0.0 --port ${PORT:-8000}"]
